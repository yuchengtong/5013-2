import os

def fmt_float(val):
    try:
        f = float(val)
        s = ('%f' % f).rstrip('0').rstrip('.')
        if '.' not in s:
            s += '.0'
        return s
    except:
        return str(val)

# 默认值取自原始 C2 脚本
ARCHIVE_PATH = os.environ.get("ARCHIVE_PATH")
PROJECT_PATH = os.environ.get("PROJECT_PATH")

LIQUID_DENSITY = fmt_float(os.environ.get("LIQUID_DENSITY", "1805.111"))
LIQUID_SPECIFIC_HEAT = fmt_float(os.environ.get("LIQUID_SPECIFIC_HEAT", "1500.111"))
