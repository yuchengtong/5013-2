# encoding: utf-8
# 2022 R2

import os

def fmt_float(val):
    try:
        f = float(val)
        s = ('%f' % f).rstrip('0').rstrip('.')
        if '.' not in s:
            s += '.0'
        return s
    except:
        return str(val)

# 从环境变量读取参数
ARCHIVE_PATH = os.environ.get("ARCHIVE_PATH")
PROJECT_PATH = os.environ.get("PROJECT_PATH")

GEOM_P1 = os.environ.get("GEOM_P1")
GEOM_P2 = os.environ.get("GEOM_P2")
GEOM_P3 = os.environ.get("GEOM_P3")
GEOM_P5 = os.environ.get("GEOM_P5")
GEOM_P6 = os.environ.get("GEOM_P6")

LIQUID_DENSITY = fmt_float(os.environ.get("LIQUID_DENSITY"))
LIQUID_SPECIFIC_HEAT = fmt_float(os.environ.get("LIQUID_SPECIFIC_HEAT"))
LIQUID_THERMAL_CONDUCTIVITY = fmt_float(os.environ.get("LIQUID_THERMAL_CONDUCTIVITY"))

BONDLINE_DENSITY = fmt_float(os.environ.get("BONDLINE_DENSITY"))
BONDLINE_SPECIFIC_HEAT = fmt_float(os.environ.get("BONDLINE_SPECIFIC_HEAT"))
