#参数传递
import os
import sys
ARCHIVE_PATH = os.environ.get("ARCHIVE_PATH")
PROJECT_DIR  = os.environ.get("PROJECT_DIR")

VALVE_OPENING=os.environ.get("VALVE_OPENING")
BONDLINE_THICKNESS=os.environ.get("BONDLINE_THICKNESS")
