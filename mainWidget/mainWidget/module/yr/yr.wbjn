import os

def fmt_float(val):
    try:
        f = float(val)
        s = ('%f' % f).rstrip('0').rstrip('.')
        if '.' not in s:
            s += '.0'
        return s
    except:
        return str(val)

# 从环境变量读取参数
ARCHIVE_PATH = os.environ.get("ARCHIVE_PATH")
PROJECT_PATH = os.environ.get("PROJECT_PATH")

BONDLINE_DENSITY = fmt_float(os.environ.get("BONDLINE_DENSITY", "900.1111"))
BONDLINE_SPECIFIC_HEAT = fmt_float(os.environ.get("BONDLINE_SPECIFIC_HEAT", "1800.111"))
BONDLINE_THERMAL_CONDUCTIVITY = fmt_float(os.environ.get("BONDLINE_THERMAL_CONDUCTIVITY", "1.1111"))
BONDLINE_ABSORPTION_COEFFICIENT = fmt_float(os.environ.get("BONDLINE_ABSORPTION_COEFFICIENT", "0.51111"))

